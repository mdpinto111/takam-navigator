{
  "Data": {
    "DatabasePath": "data/takam.db"
  },
  "Embeddings": {
    "Enabled": true,
    "ModelPath": "models/multilingual-e5-small/model.onnx",
    "SentencePiecePath": "models/multilingual-e5-small/sentencepiece.bpe.model"
  },
  "Search": {
    "StrongSemanticScore": 0.90,
    "MinSemanticScore": 0.82,
    "MinSupportingCoverage": 0.30,
    "MinKeywordCoverage": 0.6,
    "RrfK": 60,
    "CandidatesPerRetriever": 30,
    "OfficialBaseUrl": "https://takam.mof.gov.il"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
