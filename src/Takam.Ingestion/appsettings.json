{
  "TakamApi": {
    "BaseUrl": "https://takam.mof.gov.il",
    "MainChapter": 1,
    "TimeoutSeconds": 60,
    "MaxRetries": 2,
    "DelayBetweenRequestsMs": 300
  },
  "Data": {
    "SampleDir": "data/sample",
    "RawDir": "data/raw",
    "DatabasePath": "data/takam.db",
    "EvalQuestionsPath": "data/eval/questions.json"
  },
  "Embeddings": {
    "Enabled": true,
    "ModelPath": "models/multilingual-e5-small/model.onnx",
    "SentencePiecePath": "models/multilingual-e5-small/sentencepiece.bpe.model"
  },
  "Search": {
    "StrongSemanticScore": 0.9,
    "MinSemanticScore": 0.82,
    "MinSupportingCoverage": 0.3,
    "MinKeywordCoverage": 0.6,
    "RrfK": 60,
    "CandidatesPerRetriever": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http": "Warning",
      "Microsoft": "Warning"
    }
  }
}